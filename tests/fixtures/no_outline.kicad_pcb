(kicad_pcb
  (version 20221018)
  (generator "pcbnew")
  (general
    (thickness 1.6)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (42 "Eco1.User" user "User.Eco1")
    (43 "Eco2.User" user "User.Eco2")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )
  (setup
    (pad_to_mask_clearance 0)
  )
  (net 0 "")
  (net 1 "GND")
  (net 2 "VCC")

  (footprint "Resistor_SMD:R_0805_2012Metric"
    (layer "F.Cu")
    (at 100 100)
    (property "Reference" "R1")
    (property "Value" "10k")
    (pad "1" smd roundrect
      (at -0.9525 0)
      (size 0.7 0.8)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (net 1 "GND")
    )
    (pad "2" smd roundrect
      (at 0.9525 0)
      (size 0.7 0.8)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (net 2 "VCC")
    )
  )

  (footprint "Capacitor_SMD:C_0805_2012Metric"
    (layer "F.Cu")
    (at 100 110)
    (property "Reference" "C1")
    (property "Value" "100nF")
    (pad "1" smd roundrect
      (at -0.9525 0)
      (size 0.7 0.8)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (net 2 "VCC")
    )
    (pad "2" smd roundrect
      (at 0.9525 0)
      (size 0.7 0.8)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (net 1 "GND")
    )
  )

  (segment
    (start 100.9525 100)
    (end 100.9525 110)
    (width 0.25)
    (layer "F.Cu")
    (net 2)
  )

  (segment
    (start 99.0475 100)
    (end 99.0475 110)
    (width 0.25)
    (layer "F.Cu")
    (net 1)
  )
)
