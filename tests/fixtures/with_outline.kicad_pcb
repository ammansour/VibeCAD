(kicad_pcb
  (version 20221018)
  (generator "pcbnew")
  (general
    (thickness 1.6)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (44 "Edge.Cuts" user)
  )
  (setup
    (pad_to_mask_clearance 0)
  )
  (net 0 "")
  (net 1 "GND")
  (net 2 "VCC")

  (gr_line
    (start 90 90)
    (end 110 90)
    (stroke (width 0.1) (type solid))
    (layer "Edge.Cuts")
  )
  (gr_line
    (start 110 90)
    (end 110 120)
    (stroke (width 0.1) (type solid))
    (layer "Edge.Cuts")
  )
  (gr_line
    (start 110 120)
    (end 90 120)
    (stroke (width 0.1) (type solid))
    (layer "Edge.Cuts")
  )
  (gr_line
    (start 90 120)
    (end 90 90)
    (stroke (width 0.1) (type solid))
    (layer "Edge.Cuts")
  )

  (footprint "Resistor_SMD:R_0805_2012Metric"
    (layer "F.Cu")
    (at 100 100)
    (property "Reference" "R1")
    (property "Value" "10k")
    (pad "1" smd roundrect
      (at -0.9525 0)
      (size 0.7 0.8)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (net 1 "GND")
    )
    (pad "2" smd roundrect
      (at 0.9525 0)
      (size 0.7 0.8)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (net 2 "VCC")
    )
  )

  (segment
    (start 100.9525 100)
    (end 100.9525 110)
    (width 0.25)
    (layer "F.Cu")
    (net 2)
  )
)
